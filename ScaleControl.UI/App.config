<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <appSettings>
    <add key="SplashTimeout" value="2000"/>
    <add key="MaxRetryCount" value="3"/>
    <add key="RetryInterval" value="5000"/>
  </appSettings>
</configuration>
